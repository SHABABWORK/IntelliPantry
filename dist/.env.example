# ==============================================================================
# INTELLIPANTRY — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Set these variables in your Vercel Dashboard -> Settings -> Environment Variables.
# NEVER commit your real .env file or production secret keys to GitHub.

# --- Public Client Variables (Safe for Browser) ---
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Public Anon Key (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Server-Side Secrets (NEVER Expose in Frontend Code) ---
# Resend API Key for Transactional Emails (found in https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key

# Official Email Sender Address (verified in Resend or testing sender)
RESEND_FROM_EMAIL=IntelliPantry <onboarding@resend.dev>

# Production Custom Domain
SITE_URL=https://www.intellipantry.in
